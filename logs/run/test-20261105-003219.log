2026-11-05 00:32:23 | ==== TEST 2 from 15: T02 [workload/REAL] SQL workload: build and verify a star schema
2026-11-05 00:32:23 | INFO  Building a star schema (customers 10k, products 1k, sales 5000000 rows) with set-based SQL generation
2026-11-05 00:32:23 | SQL   [dbadmin@vdb-primary/labdb]  CREATE SCHEMA IF NOT EXISTS lab; DROP TABLE IF EXISTS lab.sales CASCADE; DROP TABLE IF EXISTS lab.customers CASCADE; DROP TABLE IF EXISTS lab.products CASCADE; DROP TABLE IF EXISTS lab.nums CASCADE; CREATE TABLE lab.nums AS   SELECT (ROW_NUMBER() OVER (ORDER BY slice_time) - 1)::INT AS n   FROM (SELECT slice_time FROM (SELECT '2000-01-01 00:00:00'::TIMESTAMP AS t UNION ALL SELECT '2000-01-01 02:46:39'::TIMESTAMP) s         TIMESERIES slice_time AS '1 second' OVER (ORDER BY t)) x; CREATE TABLE lab.customers (customer_id INT NOT NULL PRIMARY KEY, customer_name VARCHAR(40), region VARCHAR(16),   segment VARCHAR(16), signup_date DATE) ORDER BY customer_id UNSEGMENTED ALL NODES; INSERT INTO lab.customers SELECT n, 'customer_'||n,   CASE n%5 WHEN 0 THEN 'NORTH' WHEN 1 THEN 'SOUTH' WHEN 2 THEN 'EAST' WHEN 3 THEN 'WEST' ELSE 'CENTRAL' END,   CASE n%3 WHEN 0 THEN 'CONSUMER' WHEN 1 THEN 'SMB' ELSE 'ENTERPRISE' END, DATE '2020-01-01' + (n % 1500) FROM lab.nums; CREATE TABLE lab.products (product_id INT NOT NULL PRIMARY KEY, category VARCHAR(32), price NUMERIC(10,2))   ORDER BY product_id UNSEGMENTED ALL NODES; INSERT INTO lab.products SELECT n,   CASE n%8 WHEN 0 THEN 'ELECTRONICS' WHEN 1 THEN 'BOOKS' WHEN 2 THEN 'GROCERY' WHEN 3 THEN 'TOYS'            WHEN 4 THEN 'SPORTS' WHEN 5 THEN 'HOME' WHEN 6 THEN 'BEAUTY' ELSE 'AUTO' END,   (10 + (n % 490))::NUMERIC(10,2) FROM lab.nums WHERE n < 1000; CREATE TABLE lab.sales (sale_id INT NOT NULL, sale_ts TIMESTAMP NOT NULL, customer_id INT NOT NULL, product_id INT NOT NULL,   quantity INT, amount NUMERIC(14,2), channel VARCHAR(10))   ORDER BY sale_ts, customer_id SEGMENTED BY HASH(sale_id) ALL NODES   PARTITION BY (YEAR(sale_ts)*100 + MONTH(sale_ts)); INSERT /*+LABEL(lab_load_sales)*/ INTO lab.sales SELECT s.sale_id, s.sale_ts, s.customer_id, s.product_id, s.quantity, (s.quantity * p.price)::NUMERIC(14,2), s.channel FROM (SELECT a.n*10000 + b.n AS sale_id,              TIMESTAMPADD(SECOND, ((a.n*10000 + b.n) * 37) % 63072000, TIMESTAMP '2024-01-01 00:00:00') AS sale_ts,              ABS(HASH(a.n, b.n)) % 10000 AS customer_id,              ABS(HASH(b.n, a.n, 7)) % 1000 AS product_id,              1 + ABS(HASH(a.n + b.n)) % 5 AS quantity,              CASE ABS(HASH(a.n, b.n, 3)) % 3 WHEN 0 THEN 'WEB' WHEN 1 THEN 'STORE' ELSE 'MOBILE' END AS channel       FROM lab.nums a CROSS JOIN lab.nums b       WHERE a.n < CEIL(5000000/10000) AND a.n*10000 + b.n < 5000000) s JOIN lab.products p ON p.product_id = s.product_id; COMMIT; SELECT ANALYZE_STATISTICS('lab.sales');
