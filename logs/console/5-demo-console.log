━━ STEP 4/9 ━━ Query the rows   00:42:57
    ◆ SQL All rows
      SELECT id, city, country, reading_ts, temp_c FROM demo.city_temps ORDER BY id;
      │  id |   city    |  country  |     reading_ts      | temp_c
      │ ----+-----------+-----------+---------------------+--------
      │   1 | Tel Aviv  | Israel    | 2026-11-03 08:00:00 |   24.5
      │   2 | Jerusalem | Israel    | 2026-11-03 08:00:00 |   19.0
      │   3 | Haifa     | Israel    | 2026-11-03 08:00:00 |   22.1
      │   4 | London    | UK        | 2026-11-03 08:00:00 |   11.2
      │   5 | New York  | USA       | 2026-11-03 08:00:00 |    9.8
      │   6 | Tokyo     | Japan     | 2026-11-03 08:00:00 |   16.4
      │   7 | Sydney    | Australia | 2026-11-03 08:00:00 |   21.7
      │   8 | Tel Aviv  | Israel    | 2026-11-03 14:00:00 |   26.0
      │   9 | London    | UK        | 2026-11-03 14:00:00 |   13.0
      │  10 | Tokyo     | Japan     | 2026-11-03 14:00:00 |   18.9
      │ (10 rows)
    ◆ SQL Aggregation per country
      SELECT country, COUNT(*) AS readings, MIN(temp_c) AS min_c, MAX(temp_c) AS max_c, ROUND(AVG(temp_c),1) AS avg_c FROM demo.city_temps GROUP BY country ORDER BY avg_c DESC;
      │   country  | readings | min_c | max_c | avg_c
      │ -----------+----------+-------+-------+-------
      │  Israel    |        4 |  19.0 |  26.0 |  22.9
      │  Australia |        1 |  21.7 |  21.7 |  21.7
      │  Japan     |        2 |  16.4 |  18.9 |  17.6
      │  UK        |        2 |  11.2 |  13.0 |  12.1
      │  USA       |        1 |   9.8 |   9.8 |   9.8
      │ (5 rows)
    ◆ SQL Window function: change between readings per city
      SELECT city, reading_ts, temp_c, temp_c - LAG(temp_c) OVER (PARTITION BY city ORDER BY reading_ts) AS delta_c FROM demo.city_temps WHERE city IN ('Tel Aviv','London','Tokyo') ORDER BY city, reading_ts;
      │    city   |     reading_ts      | temp_c | delta_c
      │ ----------+---------------------+--------+---------
      │  London   | 2026-11-03 08:00:00 |   11.2 |
      │  London   | 2026-11-03 14:00:00 |   13.0 |     1.8
      │  Tel Aviv | 2026-11-03 08:00:00 |   24.5 |
      │  Tel Aviv | 2026-11-03 14:00:00 |   26.0 |     1.5
      │  Tokyo    | 2026-11-03 08:00:00 |   16.4 |
      │  Tokyo    | 2026-11-03 14:00:00 |   18.9 |     2.5
      │ (6 rows)
